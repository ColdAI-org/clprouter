{
  "name": "@clprouter/sdk",
  "version": "0.1.0",
  "description": "CLPRouter route planner SDK: route graph, k-shortest-path planner with modes and compliance filters, quotes and route envelopes",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iso20022": {
      "types": "./dist/iso20022/index.d.ts",
      "import": "./dist/iso20022/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "fast-xml-parser": "^5.11.2",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
