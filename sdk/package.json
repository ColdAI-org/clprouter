{
  "name": "@clprouter/sdk",
  "version": "0.1.0",
  "description": "CLPRouter route planner SDK: route graph, k-shortest-path planner with modes and compliance filters, quotes and route envelopes",
  "keywords": [
    "clpr",
    "clprouter",
    "hiero",
    "hedera",
    "interoperability",
    "cross-chain",
    "routing",
    "iso20022",
    "lf-decentralized-trust"
  ],
  "homepage": "https://github.com/ColdAI-org/clprouter/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/ColdAI-org/clprouter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdAI-org/clprouter.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "author": "ColdAI (https://coldai.org)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./iso20022": {
      "types": "./dist/iso20022/index.d.ts",
      "default": "./dist/iso20022/index.js"
    },
    "./data/*.json": "./data/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "data/*.json",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "fast-xml-parser": "^5.11.2",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
